# Ignore build output directory
/build
/export

# Ignore object files and dependent files
*.o
*.d

#Ignore logs folder and log files
/logs
.log

# Ignore lock files
*.lock

# Vivado/Vitis generated files
*.bin
*.pdi
*.vitisWorkspace.json
hs_err_pid*.dmp

# IDE artifacts
_ide/logs
_ide/.wsdata
.cache/
__pycache__/
*.pyc
*.pyo

# HLS Synthesized files and build artifacts
swiglu/hls/.autopilot/
swiglu/hls/.debug/
swiglu/hls/csim/build/
swiglu/hls/csim/report/
swiglu/hls/impl/
swiglu/hls/syn/
swiglu/hls/reports/
swiglu/logs/

# HLS summary files (project configuration, can be regenerated)
*.hlscompile_summary
*.hlsrun_csim_summary
*.hlsrun_package_summary

# Keep only source and config files in swiglu/hls/
!swiglu/hls/
!swiglu/hls/*.json
!swiglu/hls/*.cmdline
# Overleaf working copy of the thesis (source of truth: disi_thesis_template/)
/latex/tesi_corrected/
/latex/tesi_corrected.zip

# Large local data: KLD logit files and the final routed checkpoints (see data/README.md)
/data/
